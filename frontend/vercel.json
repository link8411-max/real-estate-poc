{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?!robots\\.txt$).*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "re": "^.*(ExaSearchBot|ElevenlabsCrawler|SERankingBacklinksBot).*$" }
        }
      ],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "re": "^.*(HeadlessChrome.*|Chrome/131\\.0\\.0\\.0 Safari/537\\.36|AppleWebKit/537\\.36)$" }
        }
      ],
      "mitigate": { "action": "challenge" }
    }
  ]
}
