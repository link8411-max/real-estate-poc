# 프론트엔드 환경변수 — 값은 frontend/.env.local 및 Vercel 에만 적는다.
# 정적 JSON 베이스 URL (R2 public 버킷 r2.dev 주소, 로컬은 http://localhost:8787)
NEXT_PUBLIC_DATA_URL=
# 카카오 지도 JavaScript 키 (카카오 개발자 콘솔에 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=
# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon(공개) 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# canonical·sitemap·OG 기준 주소 (없으면 https://real-estate-poc-self.vercel.app)
NEXT_PUBLIC_SITE_URL=https://real-estate-poc-self.vercel.app
