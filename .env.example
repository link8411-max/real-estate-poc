# 파이프라인(Python)용 환경변수 — 값은 .env 에만 적고 커밋하지 않는다.
# 국토교통부 실거래가 API 키 (하루 10,000콜 공용)
MOLIT_API_KEY=
# Cloudflare R2 S3 엔드포인트 (https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# R2 액세스 키 ID
R2_ACCESS_KEY_ID=
# R2 시크릿 액세스 키
R2_SECRET_ACCESS_KEY=
# 정본 SQLite DB 를 두는 private 버킷 이름 (real-estate-db)
R2_BUCKET_NAME=real-estate-db
# 정적 JSON 을 발행하는 public 버킷 이름 (real-estate-public)
R2_PUBLIC_BUCKET=real-estate-public
# public 버킷의 r2.dev 주소 (확인용, 프론트 NEXT_PUBLIC_DATA_URL 과 같은 값)
R2_PUBLIC_URL=
# Supabase 프로젝트 URL
SUPABASE_URL=
# Supabase service_role 키 (서버 전용, 절대 프론트에 넣지 않는다)
SUPABASE_SERVICE_ROLE_KEY=
# 카카오 REST API 키 (지오코딩용)
KAKAO_REST_API_KEY=
